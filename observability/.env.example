# ─── Application ───────────────────────────────
APP_ENV=lab
APP_VERSION=1.0.0

# ─── OpenTelemetry ─────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAMESPACE=retail-order-platform

# ─── PostgreSQL ────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=orders
POSTGRES_USER=lab
POSTGRES_PASSWORD=lab

# ─── Redis ─────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ─── RabbitMQ ──────────────────────────────────
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_URL=amqp://lab:lab@rabbitmq:5672/

# ─── Logging ───────────────────────────────────
LOG_FORMAT=json
LOG_LEVEL=INFO

# ─── Order Service Tuning ──────────────────────
PAYMENT_TIMEOUT_MS=2000
PAYMENT_MAX_RETRY=2
PAYMENT_FALLBACK_ENABLED=false
CIRCUIT_BREAKER_ENABLED=false

# ─── Fault Injection (DO NOT SET TRUE IN PRODUCTION) ───
FAULT_ENABLED=false
FAULT_TYPE=none
FAULT_DELAY_MS=0
